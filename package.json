{
  "name": "d3-force",
  "version": "3.0.0",
  "description": "Force-directed graph layout using velocity Verlet integration.",
  "homepage": "https://d3js.org/d3-force/",
  "repository": {
    "type": "git",
    "url": "https://github.com/d3/d3-force.git"
  },
  "keywords": [
    "d3",
    "d3-module",
    "layout",
    "network",
    "graph",
    "force",
    "verlet",
    "infovis"
  ],
  "license": "ISC",
  "author": {
    "name": "Mike Bostock",
    "url": "https://bost.ocks.org/mike"
  },
  "type": "module",
  "files": [
    "dist/**/*.mjs",
    "dist/**/*.js"
  ],
  "module": "dist/d3-force.mjs",
  "main": "dist/d3-force.mjs",
  "jsdelivr": "dist/d3-force.min.js",
  "unpkg": "dist/d3-force.min.js",
  "exports": {
    "umd": "./dist/d3-force.min.js",
    "default": "./dist/d3-force.mjs"
  },
  "sideEffects": false,
  "dependencies": {
    "d3-dispatch": "1 - 3",
    "d3-quadtree": "1 - 3",
    "d3-timer": "1 - 3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "rollup": "^4.67.4",
    "vitest": "^4.1.12"
  },
  "scripts": {
    "test": "vitest",
    "lint": "eslint src test",
    "prepublishOnly": "rm -rf dist && rollup -c"
  },
  "engines": {
    "node": ">=12"
  }
}
